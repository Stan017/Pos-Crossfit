DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
JWT_SECRET=genera-uno-con-python-secrets.token_urlsafe(48)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Lista separada por coma — un valor por cada frontend que consuma este backend
# (ej. el build de CrossFit y el fork médico/rehab, cada uno en su propio dominio).
FRONTEND_ORIGINS=https://tu-frontend.vercel.app,https://tu-frontend-rehab.vercel.app
PLATFORM_ADMIN_KEY=genera-uno-con-python-secrets.token_urlsafe(48)
