# Credenciales reales — nunca deben terminar horneadas dentro de la imagen
backend/.env
backend/.env.*
!backend/.env.example

# Python
**/__pycache__/
**/*.py[cod]
backend/venv/
backend/.venv/

# Tests y logs — no hacen falta en la imagen de producción
backend/tests/
backend/logs/
backend/.pytest_cache/

# Base de datos local (ES_LOCAL=True, dev con SQLite)
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Archivos subidos en dev (storage.py) — en producción esto vive en Supabase Storage
backend/static/

# Todo lo que no es backend/ — el Dockerfile no lo copia, pero no hace
# falta ni mandarlo al build context
frontend/
frontend-admin/
frontend-marketing/
frontend-rehab/
frontend-shared/
archivo-duplicados-frontend/
docs/
"New folder/"
